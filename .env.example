# adi.ai — copy to .env.local for local dev (gitignored), and add the same
# variables in Vercel → Project → Settings → Environment Variables.
# Never prefix these with VITE_: that would expose them in the browser bundle.

# Required. Server-side only.
OPENAI_API_KEY=

# Optional. Defaults to gpt-6-luna (OpenAI's lowest-cost model).
# OPENAI_MODEL=gpt-6-luna

# Optional. Defaults to "none" (no reasoning tokens = cheaper and faster).
# Set to an empty value to omit the parameter for models that don't support it.
# OPENAI_REASONING_EFFORT=none

# Optional. Extra allowed browser origins, comma-separated. adityam.page,
# www.adityam.page, localhost and this deployment's Vercel URLs are always allowed.
# ALLOWED_ORIGINS=https://example.com

# Optional. Point at an OpenAI-compatible proxy.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Dev only: stream a canned reply instead of calling OpenAI (no key needed).
# ADI_AI_MOCK=1
